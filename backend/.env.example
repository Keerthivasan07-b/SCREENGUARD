# ScreenGuard Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual keys

HOST=0.0.0.0
PORT=8000

# Authentication Tokens
STUDENT_AUTH_TOKEN=your-student-secret-token
FACULTY_AUTH_TOKEN=your-faculty-secret-token
REQUIRE_AUTH=true

# Google OAuth Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET_KEY=your-google-client-secret-key

# Monitoring & Alert Settings
HEARTBEAT_TIMEOUT_SECONDS=15.0
MAX_ALERT_HISTORY=100

# Supabase Database Configuration (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-api-key
